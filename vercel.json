{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "wellmind-server": {
      "root": "WellMind-Server",
      "framework": "express",
      "entrypoint": "server.js",
      "bindings": [
        {
          "type": "service",
          "service": "wellmind-ai-service",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    },
    "wellmind-ai-service": {
      "root": "WellMind-AI-service",
      "framework": "flask",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "wellmind-server"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "wellmind-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
